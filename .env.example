# AutoWise Environment Configuration
APP_NAME=AutoWise
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Security
SECRET_KEY=autowise-super-secret-jwt-key-development-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If MongoDB is available locally or remotely, it connects; otherwise auto-falls back to persistent JSON document store
MONGODB_ENABLED=True
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/autowise_db?retryWrites=true&w=majority
MONGODB_DB_NAME=autowise_db
USE_LOCAL_FALLBACK_IF_NO_MONGO=True

# ML Models Directory
ML_MODELS_DIR=ml/models
ML_DATA_DIR=ml/data
